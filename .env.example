# Public Discord application identifier.
DISCORD_APPLICATION_ID=1570088256945524776

# Secret token from Developer Portal -> Bot. Never commit a real value.
DISCORD_BOT_TOKEN=

# Optional separate Discord user-account token for the upstream selfbot
# transport. When empty, DFS attempts to reuse DISCORD_BOT_TOKEN. Discord may
# still reject Go Live video from bot accounts.
# Using a user token as a selfbot can result in that account being banned.
DISCORD_STREAM_USER_TOKEN=

# Optional comma-separated Discord user IDs. When empty, commands require the
# Manage Server permission configured on the slash commands.
DFS_ALLOWED_USER_IDS=

# The media is downloaded once into .cache and then replayed locally.
DFS_VIDEO_URL=https://www.youtube.com/watch?v=GBIIQ0kP15E

# Optional override for an existing yt-dlp executable.
YT_DLP_PATH=
